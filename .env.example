# AWS Cognito Authentication
# Set to 'false' for local development without authentication
# Set to 'true' for production with Cognito authentication
COGNITO_ENABLED=false

# AWS Cognito OAuth2 Configuration (required when COGNITO_ENABLED=true)
# Get these values from your AWS Cognito User Pool
COGNITO_DOMAIN=your-service-c63f2.auth.eu-west-2.amazoncognito.com
COGNITO_CLIENT_ID=your-app-client-id-here
COGNITO_CLIENT_SECRET=your-app-client-secret-here

# Object Processor API Location
# Default: http://fcp-sfd-object-processor:3004 (Docker network service name)
# Override this if the Object Processor is running elsewhere
# OBJECT_PROCESSOR_HOST=http://localhost:3004

