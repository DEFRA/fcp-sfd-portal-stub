# AWS Cognito Authentication
# Set to 'false' for local development without authentication
# Set to 'true' for production with Cognito authentication
COGNITO_ENABLED=false

# AWS Cognito OAuth2 Configuration (required when COGNITO_ENABLED=true)
# Get these values from your AWS Cognito User Pool
COGNITO_DOMAIN=your-service-c63f2.auth.eu-west-2.amazoncognito.com
COGNITO_CLIENT_ID=your-app-client-id-here
COGNITO_CLIENT_SECRET=your-app-client-secret-here

# Object Processor API Location
# Default: http://fcp-sfd-object-processor:3004 (Docker network service name)
# Override this if the Object Processor is running elsewhere
# OBJECT_PROCESSOR_HOST=http://localhost:3004

# Upload Mode Configuration
# Sets which upload pattern to use:
# - gateway-routing: Browser uploads through gateway (recommended for CDP services)
# - frontend-redirect: Browser uploads through gateway, supports multi-client redirect mapping
# - direct: Browser uploads directly to uploader (fallback, requires JavaScript)
UPLOAD_MODE=gateway-routing

# Gateway URL (for gateway-routing and frontend-redirect modes)
# The gateway domain that routes traffic to backend services
GATEWAY_URL=http://localhost:3019

# Redirect After Upload
# Where to redirect users after file upload completes
# In frontend-redirect mode, this gets prefixed with /fcp-sfd-doc-upload/{client-id}
REDIRECT_AFTER_UPLOAD=/document-upload/processing

# Additional Upload Domains for Content Security Policy
# Comma-separated list of domains allowed for browser file uploads
# Required domains depend on UPLOAD_MODE:
# - gateway-routing: No additional domains needed (uploads are same-origin)
# - frontend-redirect: Include gateway domain (http://localhost:3019) for cross-origin form POST
# - direct: Include stub uploader domain (http://localhost:3021) for direct uploads
# Default in compose.yml includes both for local development convenience
# ADDITIONAL_UPLOAD_DOMAINS=http://localhost:3019,http://localhost:3021
