{
  "name": "fcp-sfd-portal-stub",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build:frontend": "NODE_ENV=production webpack",
    "dev": "npm run frontend:watch & npm run server:watch",
    "dev:debug": "npm run frontend:watch & npm run server:debug",
    "docker:build": "docker compose build",
    "docker:dev": "docker compose up",
    "frontend:watch": "NODE_ENV=development webpack --watch",
    "git:pre-commit-hook": "npm run lint:fix",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "npm run setup:husky",
    "postversion": "git add package.json package-lock.json && git commit -m $npm_package_version",
    "server:debug": "nodemon --ext js --legacy-watch --exec 'node --env-file=.env --inspect-brk=0.0.0.0' ./src",
    "server:watch": "nodemon --ext js --legacy-watch --exec 'node --env-file=.env --inspect=0.0.0.0' ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node --use-strict ."
  },
  "author": "Defra DDTS",
  "contributors": [
    "John Watson <john.watson1@defra.gov.uk>"
  ],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.1",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/wreck": "18.1.2",
    "@hapi/yar": "11.0.3",
    "aws-embedded-metrics": "4.2.1",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "8.0.1",
    "cssnano-preset-default": "8.0.1",
    "date-fns": "4.4.0",
    "global-agent": "4.1.3",
    "govuk-frontend": "6.2.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "3.0.1",
    "joi": "18.2.1",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "semver": "7.8.2",
    "undici": "8.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.7",
    "autoprefixer": "10.5.0",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "9.29.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "neostandard": "0.12.1",
    "nodemon": "3.1.14",
    "postcss-load-config": "6.0.1",
    "postcss-loader": "8.2.1",
    "sass": "1.100.0",
    "sass-loader": "17.0.0",
    "source-map-loader": "5.0.0",
    "stylelint": "16.21.0",
    "stylelint-config-gds": "2.0.0",
    "terser-webpack-plugin": "5.6.1",
    "vitest": "4.1.7",
    "vitest-fetch-mock": "0.4.5",
    "webpack": "5.107.2",
    "webpack-assets-manifest": "6.5.2",
    "webpack-cli": "7.0.3"
  }
}
