{% extends "layouts.njk" %}

{% set pageTitle = "Upload successful" %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <div class="govuk-panel govuk-panel--confirmation">
      <h1 class="govuk-panel__title">
        {{ pageTitle }}
      </h1>
      <div class="govuk-panel__body">
        Your reference<br><strong>{{ reference }}</strong>
      </div>
    </div>

    <p class="govuk-body">
      We have received your document upload.
    </p>

    <h2 class="govuk-heading-m">What happens next</h2>

    <p class="govuk-body">
      Your documents have been scanned and accepted. They will be processed shortly.
    </p>

    <p class="govuk-body">
      You can check the status of your upload using the submission ID: <strong>{{ submissionId }}</strong>
    </p>

    <details class="govuk-details">
      <summary class="govuk-details__summary">
        <span class="govuk-details__summary-text">
          Upload details
        </span>
      </summary>
      <div class="govuk-details__text">
        <dl class="govuk-summary-list">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
              Submission ID
            </dt>
            <dd class="govuk-summary-list__value">
              {{ submissionId }}
            </dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
              Reference
            </dt>
            <dd class="govuk-summary-list__value">
              {{ reference }}
            </dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
              Upload status
            </dt>
            <dd class="govuk-summary-list__value">
              {{ uploadStatus }}
            </dd>
          </div>
          {% if uploadedFiles and uploadedFiles.length > 0 %}
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
              Uploaded files
            </dt>
            <dd class="govuk-summary-list__value">
              <ul class="govuk-list govuk-list--bullet">
                {% for filename in uploadedFiles %}
                <li>{{ filename }}</li>
                {% endfor %}
              </ul>
            </dd>
          </div>
          {% endif %}
        </dl>
      </div>
    </details>

    <p class="govuk-body">
      <a href="/document-upload/sign-in" class="govuk-link">Upload more documents</a>
    </p>

  </div>
</div>
{% endblock %}
