{% extends "layouts.njk" %}

{% set pageTitle = "Sign in to upload documents" %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <form method="post" action="/document-upload/sign-in">

      <fieldset class="govuk-fieldset">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--xl">
          <h1 class="govuk-fieldset__heading govuk-!-margin-bottom-3">
            {{ pageTitle }}
          </h1>
        </legend>

        <p class="govuk-body">
          Sign in to upload documents to the Single Front Door service.
        </p>

        <div class="govuk-form-group">
          <label class="govuk-label" for="crn">
            Customer reference number (CRN)
          </label>
          <div id="crn-hint" class="govuk-hint">
            This is the 10-digit number emailed to you when you registered with the Rural Payments service.
          </div>
          <input class="govuk-input govuk-input--width-10" id="crn" name="crn" type="text" autocomplete="off" value="1234567890" required>
        </div>

        <button type="submit" class="govuk-button" data-module="govuk-button">
          Continue
        </button>
      </fieldset>

    </form>

  </div>
</div>
{% endblock %}
